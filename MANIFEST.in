include LICENSE THIRD_PARTY_NOTICES.md CHANGELOG.md .gitattributes .gitignore
include README.en.md THIRD_PARTY_NOTICES.en.md
include .githooks/pre-commit
include setup.sh start.sh setup.bat start.bat
recursive-include scripts *.py
recursive-include docs *.md *.png
global-exclude AGENT.md AGENTS.md agent.md agents.md
prune .codex
prune .agents
prune .claude
prune .handoff
