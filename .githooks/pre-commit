#!/bin/sh
set -eu

case "${FOOTBOY_LANG:-zh-CN}" in
    en|en-*|en_*|EN|EN-*|EN_*)
        missing_changelog='Commits must include CHANGELOG.md. Record and stage the changes first.'
        unchanged_changelog='Update CHANGELOG.md with the changes and validation results before every commit, then run git add CHANGELOG.md.'
        ;;
    *)
        missing_changelog='提交必须包含 CHANGELOG.md；请记录本次变更并暂存。'
        unchanged_changelog='每次提交都必须更新 CHANGELOG.md。请补充本次变更和验证结果，再 git add CHANGELOG.md。'
        ;;
esac

if ! git cat-file -e :CHANGELOG.md 2>/dev/null; then
    printf '%s\n' "$missing_changelog" >&2
    exit 1
fi
if git diff --cached --quiet -- CHANGELOG.md; then
    printf '%s\n' "$unchanged_changelog" >&2
    exit 1
fi
